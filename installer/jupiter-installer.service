[Unit]
Description=Jupiter installer (live environment only)
ConditionPathExists=/etc/jupiter-live
After=systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service
Before=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/libexec/jupiter/jupiter-installer.py
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=no

[Install]
WantedBy=multi-user.target
